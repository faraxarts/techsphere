<%- include('../partials/head', { title }) %>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>

<%
  const currentProfile = typeof profile !== 'undefined' && profile ? profile : {};
  const social = currentProfile.socialLinks || {};
%>

<main class="px-5 py-16 lg:px-8">
  <section class="mx-auto max-w-7xl text-center">
    <p class="eyebrow justify-center">Contact</p>

    <h1 class="mt-4 font-display text-4xl font-black text-white md:text-6xl">
      Let’s build, collaborate, or connect.
    </h1>

    <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-slate-300">
      Have an opportunity, project idea, feedback, or question? Send a message and I’ll get back to you.
    </p>
  </section>

  <section class="mx-auto mt-12 grid max-w-7xl gap-8 lg:grid-cols-[.85fr_1.15fr]">
    <aside class="space-y-6">
      <div class="glass-card p-6">
        <p class="eyebrow">Profile</p>

        <div class="mt-6 flex items-center gap-4">
          <% if (currentProfile.profileImage) { %>
  <img
    src="<%= currentProfile.profileImage %>"
    alt="<%= currentProfile.ownerName || 'Profile image' %>"
    class="h-16 w-16 rounded-full border border-blue-400/30 object-cover shadow-glow"
  >
<% } else { %>
  <div class="grid h-16 w-16 place-items-center rounded-full border border-blue-400/30 bg-blue-500/10 text-2xl font-bold text-white shadow-glow">
    <%= currentProfile.initials || 'FA' %>
  </div>
<% } %>

          <div>
            <h2 class="text-xl font-bold text-white">
              <%= currentProfile.ownerName || 'Faramade Ayeni' %>
            </h2>

            <p class="mt-1 text-sm text-cyan-300">
              <%= currentProfile.professionalTitle || 'Web Developer • Tech Writer' %>
            </p>
          </div>
        </div>

        <p class="mt-5 text-sm leading-7 text-slate-400">
          <%= currentProfile.aboutIntro || 'A developer building web applications, documenting the journey, and sharing practical technology knowledge.' %>
        </p>
      </div>

      <div class="glass-card p-6">
        <p class="eyebrow">Contact Details</p>

        <div class="mt-6 space-y-4">
          <div class="contact-info-card">
            <span>Email</span>
            <a href="mailto:<%= currentProfile.email || 'hello@techsphere.dev' %>">
              <%= currentProfile.email || 'hello@techsphere.dev' %>
            </a>
          </div>

          <div class="contact-info-card">
            <span>Location</span>
            <strong><%= currentProfile.location || 'Remote' %></strong>
          </div>

          <div class="contact-info-card">
            <span>Availability</span>
            <strong><%= currentProfile.availabilityStatus || 'Open to opportunities' %></strong>
          </div>
        </div>
      </div>

      <div class="glass-card p-6">
        <p class="eyebrow">Social Links</p>

        <div class="mt-6 flex flex-wrap gap-3">
          <% if (social.github && social.github !== '#') { %>
            <a href="<%= social.github %>" target="_blank" rel="noopener noreferrer" class="btn-secondary">GitHub</a>
          <% } %>

          <% if (social.linkedin && social.linkedin !== '#') { %>
            <a href="<%= social.linkedin %>" target="_blank" rel="noopener noreferrer" class="btn-secondary">LinkedIn</a>
          <% } %>

          <% if (social.twitter && social.twitter !== '#') { %>
            <a href="<%= social.twitter %>" target="_blank" rel="noopener noreferrer" class="btn-secondary">Twitter/X</a>
          <% } %>

          <% if (social.resume && social.resume !== '#') { %>
            <a href="<%= social.resume %>" target="_blank" rel="noopener noreferrer" class="btn-secondary">Resume</a>
          <% } %>

          <% if ((!social.github || social.github === '#') && (!social.linkedin || social.linkedin === '#') && (!social.twitter || social.twitter === '#') && (!social.resume || social.resume === '#')) { %>
            <p class="text-sm text-slate-500">
              Social links have not been added yet. You can add them from Admin → Site Settings.
            </p>
          <% } %>
        </div>
      </div>
    </aside>

    <section class="glass-card p-6 md:p-8">
      <p class="eyebrow">Send a Message</p>

      <h2 class="mt-3 text-3xl font-bold text-white">
        Start a conversation
      </h2>

      <p class="mt-3 text-sm leading-7 text-slate-400">
        Your message will be saved securely in the admin dashboard for review.
      </p>

      <form action="/contact" method="POST" class="mt-8 space-y-5">
        <div class="grid gap-5 md:grid-cols-2">
          <div>
            <label class="form-label">Name</label>
            <input class="form-input" type="text" name="name" placeholder="Your name" required>
          </div>

          <div>
            <label class="form-label">Email</label>
            <input class="form-input" type="email" name="email" placeholder="you@example.com" required>
          </div>
        </div>

        <div>
          <label class="form-label">Subject</label>
          <input class="form-input" type="text" name="subject" placeholder="What is this about?" required>
        </div>

        <div>
          <label class="form-label">Message</label>
          <textarea class="form-input min-h-44" name="message" placeholder="Write your message..." required></textarea>
        </div>

        <button class="btn-primary" type="submit">
          Send Message
        </button>
      </form>
    </section>
  </section>
</main>

<%- include('../partials/footer') %>
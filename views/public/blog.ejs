<%- include('../partials/head', { title }) %>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>

<main class="px-5 py-16 lg:px-8">
  <section class="mx-auto max-w-7xl text-center">
    <p class="eyebrow justify-center">Tech Writing</p>
    <h1 class="mt-4 font-display text-4xl font-black text-white md:text-6xl">TechSphere Blog</h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-slate-300">
      Practical articles, project breakdowns, learning notes, and thoughts from my developer journey.
    </p>
  </section>

  <section class="mx-auto mt-10 max-w-5xl">
    <form action="/blog" method="GET" class="glass-card flex flex-col gap-4 p-4">
      <input type="search" name="search" value="<%= search || '' %>" placeholder="Search articles, categories, or topics..." class="form-input">
      <div class="flex flex-wrap justify-center gap-2">
        <% categories.forEach(category => { %>
          <button name="category" value="<%= category %>" class="filter-chip <%= selectedCategory === category ? 'active' : '' %>"><%= category %></button>
        <% }) %>
      </div>
    </form>
  </section>

  <section class="mx-auto mt-12 max-w-7xl">
    <% if (posts.length) { %>
      <% const featuredPost = posts[0]; %>
      <article class="glass-card grid gap-8 p-5 md:grid-cols-[.9fr_1.1fr] md:p-6">
        <img src="<%= featuredPost.featuredImage || featuredPost.image || '/images/placeholders/blog-1.svg' %>" alt="<%= featuredPost.title %>" class="h-64 w-full rounded-[1.5rem] object-cover md:h-full">
        <div class="flex flex-col justify-center py-4">
          <div class="flex flex-wrap items-center gap-3 text-xs text-slate-500">
            <span class="category-pill"><%= featuredPost.category || 'Learning Journey' %></span>
            <span><%= featuredPost.readingTime || 3 %> min read</span>
          </div>
          <h2 class="mt-4 font-display text-3xl font-bold text-white md:text-4xl"><%= featuredPost.title %></h2>
          <p class="mt-4 leading-7 text-slate-300"><%= featuredPost.excerpt %></p>
          <a href="/blog/<%= featuredPost.slug || featuredPost._id %>" class="btn-primary mt-6 w-fit">Read Featured Article</a>
        </div>
      </article>

      <div class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        <% posts.slice(1).forEach(post => { %>
          <article class="blog-card">
            <img src="<%= post.featuredImage || post.image || '/images/placeholders/blog-2.svg' %>" alt="<%= post.title %>" class="h-44 w-full rounded-2xl object-cover">
            <div class="mt-5 flex items-center gap-3 text-xs text-slate-500">
              <span class="category-pill"><%= post.category || 'Learning Journey' %></span>
              <span><%= post.readingTime || 3 %> min read</span>
            </div>
            <h2 class="mt-4 text-xl font-bold text-white"><%= post.title %></h2>
            <p class="mt-3 line-clamp-3 text-sm leading-6 text-slate-400"><%= post.excerpt %></p>
            <a href="/blog/<%= post.slug || post._id %>" class="mt-6 inline-flex text-sm font-semibold text-cyan-300 hover:text-cyan-200">Read More →</a>
          </article>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state">No articles matched your search yet.</div>
    <% } %>
  </section>
</main>

<%- include('../partials/footer') %>

<%- include('../partials/head', { title }) %>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>

<main class="px-5 py-16 lg:px-8">
  <article class="mx-auto max-w-7xl">
    <div class="grid gap-10 lg:grid-cols-[1.15fr_.85fr] lg:items-start">
      <div>
        <p class="eyebrow"><%= project.category || 'Project Case Study' %></p>
        <h1 class="mt-4 font-display text-4xl font-black text-white md:text-6xl"><%= project.title %></h1>
        <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-300"><%= project.summary %></p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="<%= project.liveUrl || '#' %>" class="btn-primary">Live Demo</a>
          <a href="<%= project.githubUrl || '#' %>" class="btn-secondary">GitHub</a>
          <a href="/projects" class="btn-ghost">Back to Projects</a>
        </div>
      </div>
      <aside class="glass-card p-6">
        <p class="text-sm text-slate-500">Project Status</p>
        <p class="mt-2 text-xl font-bold text-cyan-300"><%= project.status || 'In Progress' %></p>
        <div class="mt-6 border-t border-white/10 pt-6">
          <p class="text-sm text-slate-500">Tech Stack</p>
          <div class="mt-4 flex flex-wrap gap-2">
            <% (project.techStack || []).forEach(tech => { %>
              <span class="tech-badge"><%= tech %></span>
            <% }) %>
          </div>
        </div>
      </aside>
    </div>

    <img src="<%= project.image || '/images/placeholders/project-1.svg' %>" alt="<%= project.title %>" class="mt-12 h-[260px] w-full rounded-[2rem] border border-white/10 object-cover shadow-soft md:h-[460px]">

    <div class="mt-12 grid gap-8 lg:grid-cols-[1fr_.7fr]">
      <div class="space-y-6">
        <section class="content-panel">
          <h2>Project Purpose</h2>
          <p><%= project.description || project.summary %></p>
        </section>
        <section class="content-panel">
          <h2>Problem Statement</h2>
          <p><%= project.problem || 'This project solves a practical development problem and gives room to demonstrate design, implementation, and problem-solving ability.' %></p>
        </section>
        <section class="content-panel">
          <h2>Development Process</h2>
          <p><%= project.caseStudy || 'The process focuses on understanding the goal, structuring the backend, designing reusable UI components, and connecting the data flow through Express and MongoDB.' %></p>
        </section>
        <section class="content-panel">
          <h2>Lessons Learned</h2>
          <p><%= project.lessons || 'Every project should improve technical ability, communication, and product thinking.' %></p>
        </section>
      </div>
      <aside class="space-y-6">
        <div class="glass-card p-6">
          <h2 class="text-xl font-bold text-white">Key Features</h2>
          <ul class="mt-5 space-y-3 text-sm text-slate-300">
            <% (project.features || []).forEach(feature => { %>
              <li class="flex gap-3"><span class="mt-1 h-2 w-2 rounded-full bg-cyan-300"></span><span><%= feature %></span></li>
            <% }) %>
          </ul>
        </div>
        <div class="glass-card p-6">
          <h2 class="text-xl font-bold text-white">Related Projects</h2>
          <div class="mt-5 grid gap-4">
            <% relatedProjects.forEach(item => { %>
              <a href="/projects/<%= item.slug %>" class="rounded-2xl border border-white/10 bg-white/[0.03] p-4 transition hover:border-cyan-300/40">
                <span class="block text-sm font-semibold text-white"><%= item.title %></span>
                <span class="mt-1 block text-xs text-slate-500"><%= item.category %></span>
              </a>
            <% }) %>
          </div>
        </div>
      </aside>
    </div>
  </article>
</main>

<%- include('../partials/footer') %>

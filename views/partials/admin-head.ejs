<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title || 'TechSphere Admin' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'ui-sans-serif', 'system-ui'],
            display: ['Space Grotesk', 'Inter', 'ui-sans-serif'],
            mono: ['JetBrains Mono', 'ui-monospace']
          },
          colors: {
            sphere: {
              bg: '#020617',
              panel: '#07111f',
              panel2: '#0b1628',
              border: '#1f3b5f',
              blue: '#2f80ff',
              cyan: '#22d3ee',
              muted: '#94a3b8'
            }
          },
          boxShadow: {
            glow: '0 0 35px rgba(47, 128, 255, 0.25)',
            soft: '0 24px 80px rgba(0, 0, 0, 0.35)'
          }
        }
      }
    }
  </script>
  <link rel="stylesheet" href="/css/custom.css" />
  <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
</head>
<body class="min-h-screen bg-sphere-bg text-slate-100 font-sans antialiased">

<% if (success && success.length > 0) { %>
  <div class="mx-auto mt-6 max-w-7xl px-5 lg:px-8">
    <div class="rounded-2xl border border-emerald-400/30 bg-emerald-400/10 px-5 py-4 text-sm font-medium text-emerald-200">
      <%= success[0] %>
    </div>
  </div>
<% } %>

<% if (error && error.length > 0) { %>
  <div class="mx-auto mt-6 max-w-7xl px-5 lg:px-8">
    <div class="rounded-2xl border border-rose-400/30 bg-rose-400/10 px-5 py-4 text-sm font-medium text-rose-200">
      <%= error[0] %>
    </div>
  </div>
<% } %>

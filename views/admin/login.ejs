<%- include('../partials/admin-head', { title }) %>
<div class="fixed inset-0 -z-10 bg-[radial-gradient(circle_at_50%_20%,rgba(47,128,255,.18),transparent_28%),#020617]"></div>
<div class="fixed inset-0 -z-10 grid-noise opacity-70"></div>

<main class="grid min-h-screen place-items-center px-5 py-12">
  <section class="w-full max-w-md">
    <div class="mb-8 text-center">
      <a href="/" class="inline-flex items-center gap-3">
        <span class="grid h-11 w-11 place-items-center rounded-xl border border-blue-400/30 bg-blue-500/10 shadow-glow">
          <span class="h-3 w-3 rounded-full bg-cyan-300"></span>
        </span>
        <span class="font-display text-xl font-bold text-white">TechSphere</span>
      </a>
    </div>

    <div class="glass-card p-8">
      <p class="eyebrow justify-center">Private Access</p>
      <h1 class="mt-4 text-center font-display text-3xl font-bold text-white">Admin Login</h1>
      <p class="mt-3 text-center text-sm text-slate-400">This area is for the site owner only.</p>

      <div class="mt-6">
        <%- include('../partials/admin-flash') %>
      </div>

      <form action="/admin/login" method="POST" class="mt-6 space-y-5">
        <div>
          <label class="form-label">Email Address</label>
          <input class="form-input" type="email" name="email" required placeholder="admin@example.com">
        </div>
        <div>
          <label class="form-label">Password</label>
          <input class="form-input" type="password" name="password" required placeholder="••••••••">
        </div>
        <button class="btn-primary w-full justify-center" type="submit">Login to Dashboard</button>
      </form>

      <a href="/" class="mt-6 inline-flex w-full justify-center text-sm text-slate-400 hover:text-cyan-300">← Back to website</a>
    </div>
  </section>
</main>
</body>
</html>

<%- include('../partials/admin-head', { title }) %>
<%- include('../partials/admin-sidebar') %>

<main class="lg:pl-72">
  <div class="mx-auto max-w-7xl px-5 py-8 lg:px-8">
    <%- include('../partials/admin-flash') %>
    <div class="mb-8">
      <p class="eyebrow">Portfolio Project</p>
      <h1 class="mt-3 font-display text-4xl font-bold text-white">Add New Project</h1>
      <p class="mt-2 text-slate-400">Create a case study that explains the project, stack, features, and lessons learned.</p>
    </div>

    <form action="/admin/projects" method="POST" enctype="multipart/form-data" class="grid gap-6 xl:grid-cols-[1fr_360px]">
      <section class="admin-panel space-y-5">
        <div>
          <label class="form-label">Project Title</label>
          <input class="form-input" type="text" name="title" required placeholder="e.g. Neural Dashboard">
        </div>
        <div>
          <label class="form-label">Summary</label>
          <textarea class="form-input min-h-24" name="summary" required placeholder="Short project summary..."></textarea>
        </div>
        <div>
          <label class="form-label">Problem Statement</label>
          <textarea class="form-input min-h-24" name="problem" placeholder="What problem does this solve?"></textarea>
        </div>
        <div>
          <label class="form-label">Project Purpose / Description</label>
          <textarea class="form-input min-h-28" name="description" placeholder="Why the project exists..."></textarea>
        </div>
        <div>
          <label class="form-label">Case Study Content</label>
          <textarea class="form-input min-h-40" name="caseStudy" placeholder="Process, challenges, decisions, implementation details..."></textarea>
        </div>
        <div>
          <label class="form-label">Lessons Learned</label>
          <textarea class="form-input min-h-24" name="lessons" placeholder="What did you learn?"></textarea>
        </div>
      </section>

      <aside class="space-y-6">
        <div class="admin-panel space-y-5">
          <div>
            <label class="form-label">Slug</label>
            <input class="form-input" type="text" name="slug" placeholder="auto-generated-if-empty">
          </div>
          <div>
            <label class="form-label">Category</label>
            <input class="form-input" type="text" name="category" value="Full-Stack">
          </div>
          <div>
            <label class="form-label">Tech Stack</label>
            <input class="form-input" type="text" name="techStack" placeholder="Node.js, Express, MongoDB">
          </div>
          <div>
            <label class="form-label">Features</label>
            <input class="form-input" type="text" name="features" placeholder="Admin login, CRUD, Contact form">
          </div>
<div>
  <label class="form-label">Project Image URL</label>
  <input
    class="form-input"
    type="text"
    name="image"
    value="<%= project && project.image ? project.image : '' %>"
    placeholder="https://example.com/project-image.jpg or leave empty"
  >
  <p class="mt-2 text-xs text-slate-500">
    Paste an online image URL, or upload an image below.
  </p>
</div>

<div>
  <label class="form-label">Upload Project Image</label>
  <input
    class="form-input"
    type="file"
    name="imageFile"
    accept="image/jpeg,image/jpg,image/png,image/webp,image/gif"
  >
  <p class="mt-2 text-xs text-slate-500">
    Accepted formats: JPG, PNG, WEBP, GIF. Maximum size: 5MB.
  </p>
</div>
          <div>
            <label class="form-label">GitHub Link</label>
            <input class="form-input" type="url" name="githubUrl" placeholder="https://github.com/...">
          </div>
          <div>
            <label class="form-label">Live Demo Link</label>
            <input class="form-input" type="url" name="liveUrl" placeholder="https://...">
          </div>
          <div>
            <label class="form-label">Status</label>
            <select class="form-input" name="status">
              <option>In Progress</option>
              <option>Completed</option>
              <option>Planned</option>
            </select>
          </div>
          <label class="flex items-center gap-3 text-sm text-slate-300">
            <input type="checkbox" name="featured" class="h-4 w-4 rounded border-white/20 bg-slate-900">
            Featured project
          </label>
          <button class="btn-primary w-full justify-center" type="submit">Save Project</button>
          <a href="/admin/projects" class="btn-secondary w-full justify-center">Cancel</a>
        </div>
      </aside>
    </form>
  </div>
</main>

<%- include('../partials/admin-footer') %>

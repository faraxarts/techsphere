<%- include('../partials/admin-head', { title }) %>
<%- include('../partials/admin-sidebar') %>

<main class="lg:pl-72">
  <div class="mx-auto max-w-7xl px-5 py-8 lg:px-8">
    <%- include('../partials/admin-flash') %>
    <div class="mb-8">
      <p class="eyebrow">Contact Inbox</p>
      <h1 class="mt-3 font-display text-4xl font-bold text-white">Messages</h1>
      <p class="mt-2 text-slate-400">Messages submitted through the public contact form.</p>
    </div>

    <section class="grid gap-4">
      <% messages.forEach(message => { %>
        <article class="admin-panel">
          <div class="flex flex-col justify-between gap-4 md:flex-row md:items-start">
            <div>
              <div class="flex flex-wrap items-center gap-3">
                <h2 class="text-xl font-bold text-white"><%= message.subject %></h2>
                <% if (!message.read) { %><span class="mini-badge">New</span><% } %>
              </div>
              <p class="mt-2 text-sm text-slate-500">From <%= message.name %> • <%= message.email %> • <%= new Date(message.createdAt).toLocaleString() %></p>
            </div>
            <div class="flex gap-2">
              <% if (!message.read) { %>
                <form action="/admin/messages/<%= message._id %>/read" method="POST">
                  <button class="table-action" type="submit">Mark Read</button>
                </form>
              <% } %>
              <form action="/admin/messages/<%= message._id %>/delete" method="POST" onsubmit="return confirm('Delete this message?')">
                <button class="table-action-danger" type="submit">Delete</button>
              </form>
            </div>
          </div>
          <p class="mt-5 whitespace-pre-line leading-7 text-slate-300"><%= message.message %></p>
        </article>
      <% }) %>
      <% if (!messages.length) { %><div class="empty-state">No contact messages yet.</div><% } %>
    </section>
  </div>
</main>

<%- include('../partials/admin-footer') %>

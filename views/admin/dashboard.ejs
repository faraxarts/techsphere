<%- include('../partials/admin-head', { title }) %>
<%- include('../partials/admin-sidebar') %>

<%
  const dashboardStats = typeof stats !== 'undefined' && stats ? stats : {};
  const completion = typeof profileCompletion !== 'undefined' && profileCompletion ? profileCompletion : { percent: 0, completed: 0, total: 0 };
  const completionPercent = Math.max(0, Math.min(100, Number(completion.percent) || 0));
  const posts = typeof latestPosts !== 'undefined' && Array.isArray(latestPosts) ? latestPosts : [];
  const projects = typeof latestProjects !== 'undefined' && Array.isArray(latestProjects) ? latestProjects : [];
  const messages = typeof latestMessages !== 'undefined' && Array.isArray(latestMessages) ? latestMessages : [];

  function formatDate(dateValue) {
    if (!dateValue) return 'Recent';
    return new Date(dateValue).toLocaleDateString('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric'
    });
  }
%>

<main class="lg:pl-72">
  <div class="mx-auto max-w-7xl px-5 py-8 lg:px-8">
    <%- include('../partials/admin-flash') %>

    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div>
        <p class="eyebrow">Admin Overview</p>
        <h1 class="mt-3 font-display text-4xl font-bold text-white">Dashboard</h1>
        <p class="mt-2 text-slate-400">
          Manage TechSphere content, monitor messages, track news cache, and complete your portfolio profile.
        </p>
      </div>

      <div class="flex flex-wrap gap-3">
        <a href="/admin/settings" class="btn-secondary">Site Settings</a>
        <a href="/admin/posts/new" class="btn-primary">New Post</a>
      </div>
    </div>

    <section class="mt-8 grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
      <div class="admin-panel p-6">
        <p class="text-sm text-slate-400">Total Posts</p>
        <strong class="mt-3 block text-4xl font-black text-white"><%= dashboardStats.totalPosts || 0 %></strong>
        <p class="mt-2 text-xs text-slate-500">
          <%= dashboardStats.publishedPosts || 0 %> published • <%= dashboardStats.draftPosts || 0 %> drafts
        </p>
      </div>

      <div class="admin-panel p-6">
        <p class="text-sm text-slate-400">Projects</p>
        <strong class="mt-3 block text-4xl font-black text-white"><%= dashboardStats.totalProjects || 0 %></strong>
        <p class="mt-2 text-xs text-slate-500">
          <%= dashboardStats.featuredProjects || 0 %> featured projects
        </p>
      </div>

      <div class="admin-panel p-6">
        <p class="text-sm text-slate-400">Messages</p>
        <strong class="mt-3 block text-4xl font-black text-white"><%= dashboardStats.totalMessages || 0 %></strong>
        <p class="mt-2 text-xs text-slate-500">
          <%= dashboardStats.unreadMessages || 0 %> unread messages
        </p>
      </div>

      <div class="admin-panel p-6">
        <p class="text-sm text-slate-400">Cached News</p>
        <strong class="mt-3 block text-4xl font-black text-white"><%= dashboardStats.totalNewsItems || 0 %></strong>
        <p class="mt-2 text-xs text-slate-500">
          <%= dashboardStats.importedNewsItems || 0 %> imported as drafts
        </p>
      </div>
    </section>

    <section class="mt-8 grid gap-6 lg:grid-cols-[.9fr_1.1fr]">
      <div class="admin-panel p-6">
        <div class="flex items-center justify-between gap-4">
          <div>
            <p class="eyebrow">Portfolio Profile</p>
            <h2 class="mt-3 text-2xl font-bold text-white">Profile Completion</h2>
          </div>

          <strong class="text-3xl font-black text-cyan-300">
            <%= completion.percent || 0 %>%
          </strong>
        </div>

        <div class="mt-6 h-3 overflow-hidden rounded-full bg-slate-800">
  <div
    class="h-full rounded-full bg-cyan-400"
    <%- 'style="width: ' + completionPercent + '%;"' %>
  ></div>
</div>

        <p class="mt-4 text-sm text-slate-400">
          <%= completion.completed || 0 %> of <%= completion.total || 0 %> important profile fields completed.
        </p>

        <p class="mt-3 text-sm leading-6 text-slate-500">
          Complete your settings so the homepage, about page, contact page, and footer feel professional and personal.
        </p>

        <a href="/admin/settings" class="btn-primary mt-6">Update Site Settings</a>
      </div>

      <div class="admin-panel p-6">
        <div class="flex items-center justify-between gap-4">
          <div>
            <p class="eyebrow">Quick Actions</p>
            <h2 class="mt-3 text-2xl font-bold text-white">Manage TechSphere</h2>
          </div>
        </div>

        <div class="mt-6 grid gap-3 sm:grid-cols-2">
          <a href="/admin/posts/new" class="quick-action-card">
            <strong>Create Blog Post</strong>
            <span>Write tutorials, updates, and project breakdowns.</span>
          </a>

          <a href="/admin/projects/new" class="quick-action-card">
            <strong>Add Project</strong>
            <span>Showcase a new portfolio project.</span>
          </a>

          <a href="/admin/news" class="quick-action-card">
            <strong>Refresh Tech News</strong>
            <span>Fetch and import external tech news.</span>
          </a>

          <a href="/admin/messages" class="quick-action-card">
            <strong>View Messages</strong>
            <span>Review contact form submissions.</span>
          </a>
        </div>
      </div>
    </section>

    <section class="mt-8 grid gap-6 xl:grid-cols-3">
      <div class="admin-panel p-6">
        <div class="flex items-center justify-between">
          <h2 class="text-xl font-bold text-white">Latest Posts</h2>
          <a href="/admin/posts" class="text-sm font-semibold text-cyan-300 hover:text-cyan-200">View All</a>
        </div>

        <div class="mt-5 space-y-4">
          <% if (posts.length) { %>
            <% posts.forEach(post => { %>
              <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4">
                <p class="font-semibold text-white"><%= post.title %></p>
                <div class="mt-2 flex flex-wrap gap-2 text-xs text-slate-500">
                  <span><%= post.status || 'draft' %></span>
                  <span>•</span>
                  <span><%= formatDate(post.createdAt) %></span>
                </div>
                <a href="/admin/posts/<%= post._id %>/edit" class="mt-3 inline-flex text-sm text-cyan-300 hover:text-cyan-200">
                  Edit →
                </a>
              </div>
            <% }) %>
          <% } else { %>
            <p class="text-sm text-slate-500">No blog posts yet.</p>
          <% } %>
        </div>
      </div>

      <div class="admin-panel p-6">
        <div class="flex items-center justify-between">
          <h2 class="text-xl font-bold text-white">Latest Projects</h2>
          <a href="/admin/projects" class="text-sm font-semibold text-cyan-300 hover:text-cyan-200">View All</a>
        </div>

        <div class="mt-5 space-y-4">
          <% if (projects.length) { %>
            <% projects.forEach(project => { %>
              <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4">
                <p class="font-semibold text-white"><%= project.title %></p>
                <div class="mt-2 flex flex-wrap gap-2 text-xs text-slate-500">
                  <span><%= project.status || 'Project' %></span>
                  <% if (project.featured) { %>
                    <span>• Featured</span>
                  <% } %>
                </div>
                <a href="/admin/projects/<%= project._id %>/edit" class="mt-3 inline-flex text-sm text-cyan-300 hover:text-cyan-200">
                  Edit →
                </a>
              </div>
            <% }) %>
          <% } else { %>
            <p class="text-sm text-slate-500">No projects yet.</p>
          <% } %>
        </div>
      </div>

      <div class="admin-panel p-6">
        <div class="flex items-center justify-between">
          <h2 class="text-xl font-bold text-white">Latest Messages</h2>
          <a href="/admin/messages" class="text-sm font-semibold text-cyan-300 hover:text-cyan-200">View All</a>
        </div>

        <div class="mt-5 space-y-4">
          <% if (messages.length) { %>
            <% messages.forEach(message => { %>
              <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4">
                <p class="font-semibold text-white"><%= message.subject || 'No subject' %></p>
                <p class="mt-1 text-sm text-slate-400"><%= message.name || 'Unknown sender' %></p>
                <p class="mt-2 line-clamp-2 text-xs leading-5 text-slate-500">
                  <%= message.message || '' %>
                </p>
              </div>
            <% }) %>
          <% } else { %>
            <p class="text-sm text-slate-500">No contact messages yet.</p>
          <% } %>
        </div>
      </div>
    </section>
  </div>
</main>

<%- include('../partials/admin-footer') %>
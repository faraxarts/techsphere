<%- include('../partials/admin-head', { title }) %>
<%- include('../partials/admin-sidebar') %>

<main class="lg:pl-72">
  <div class="mx-auto max-w-6xl px-5 py-8 lg:px-8">
    <%- include('../partials/admin-flash') %>

    <% const social = profile.socialLinks || {}; %>
    <% const profileStats = profile.stats || {}; %>

    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div>
        <p class="eyebrow">Portfolio Identity</p>
        <h1 class="mt-3 font-display text-4xl font-bold text-white">Site Settings</h1>
        <p class="mt-2 max-w-2xl text-slate-400">
          Manage the public identity of TechSphere without editing code.
        </p>
      </div>

      <a href="/" target="_blank" class="btn-secondary">View Site</a>
    </div>

    <form action="/admin/settings" method="POST" enctype="multipart/form-data" class="mt-8 space-y-8">
      <section class="admin-panel p-6 md:p-8">
        <h2 class="text-2xl font-bold text-white">Basic Identity</h2>
        <p class="mt-2 text-sm text-slate-400">This controls your name, title, contact information, and site branding.</p>

        <div class="mt-6 grid gap-5 md:grid-cols-2">
          <div>
            <label class="form-label">Site Name</label>
            <input class="form-input" name="siteName" value="<%= profile.siteName || '' %>" placeholder="TechSphere">
          </div>

          <div>
            <label class="form-label">Owner Name</label>
            <input class="form-input" name="ownerName" value="<%= profile.ownerName || '' %>" placeholder="Faramade Ayeni">
          </div>

          <div>
            <label class="form-label">Initials</label>
            <input class="form-input" name="initials" value="<%= profile.initials || '' %>" placeholder="FA">
          </div>
          <div class="md:col-span-2">
  <label class="form-label">Profile Image URL</label>
  <input
    class="form-input"
    name="profileImage"
    value="<%= profile.profileImage || '' %>"
    placeholder="https://example.com/profile.jpg or upload below"
  >
  <p class="mt-2 text-xs text-slate-500">
    Paste an online profile image URL, or upload an image from your computer below.
  </p>
</div>

<div class="md:col-span-2">
  <label class="form-label">Upload Profile Image</label>
  <input
    class="form-input"
    type="file"
    name="profileImageFile"
    accept="image/jpeg,image/jpg,image/png,image/webp"
  >
  <p class="mt-2 text-xs text-slate-500">
    Accepted formats: JPG, PNG, WEBP. Recommended: square image. Maximum size: 8MB.
  </p>

  <% if (profile.profileImage) { %>
    <div class="mt-4 flex items-center gap-4">
      <img
        src="<%= profile.profileImage %>"
        alt="Current profile image"
        class="h-20 w-20 rounded-2xl object-cover"
      >
      <span class="text-sm text-slate-400">Current profile image</span>
    </div>
  <% } %>
</div>

          <div>
            <label class="form-label">Professional Title</label>
            <input class="form-input" name="professionalTitle" value="<%= profile.professionalTitle || '' %>" placeholder="Web Developer • Tech Writer">
          </div>

          <div>
            <label class="form-label">Availability Status</label>
            <input class="form-input" name="availabilityStatus" value="<%= profile.availabilityStatus || '' %>" placeholder="Open to opportunities">
          </div>

          <div>
            <label class="form-label">Location</label>
            <input class="form-input" name="location" value="<%= profile.location || '' %>" placeholder="Remote">
          </div>

          <div class="md:col-span-2">
            <label class="form-label">Email</label>
            <input class="form-input" type="email" name="email" value="<%= profile.email || '' %>" placeholder="hello@example.com">
          </div>
        </div>
      </section>

      <section class="admin-panel p-6 md:p-8">
        <h2 class="text-2xl font-bold text-white">Homepage Hero</h2>
        <p class="mt-2 text-sm text-slate-400">This controls the main first impression on the homepage.</p>

        <div class="mt-6 grid gap-5">
          <div>
            <label class="form-label">Hero Eyebrow</label>
            <input class="form-input" name="heroEyebrow" value="<%= profile.heroEyebrow || '' %>" placeholder="Portfolio & Tech Blog">
          </div>

          <div>
            <label class="form-label">Hero Headline</label>
            <textarea class="form-input min-h-28" name="heroHeadline" placeholder="Main headline"><%= profile.heroHeadline || '' %></textarea>
          </div>

          <div>
            <label class="form-label">Hero Description</label>
            <textarea class="form-input min-h-32" name="heroDescription" placeholder="Short description"><%= profile.heroDescription || '' %></textarea>
          </div>
        </div>
      </section>

      <section class="admin-panel p-6 md:p-8">
        <h2 class="text-2xl font-bold text-white">About Content</h2>
        <p class="mt-2 text-sm text-slate-400">This controls the About page and portfolio story.</p>

        <div class="mt-6 grid gap-5">
          <div>
            <label class="form-label">About Intro</label>
            <textarea class="form-input min-h-32" name="aboutIntro"><%= profile.aboutIntro || '' %></textarea>
          </div>

          <div>
            <label class="form-label">Bio</label>
            <textarea class="form-input min-h-40" name="bio"><%= profile.bio || '' %></textarea>
          </div>

          <div>
            <label class="form-label">Current Focus Title</label>
            <input class="form-input" name="currentFocusTitle" value="<%= profile.currentFocusTitle || '' %>">
          </div>

          <div>
            <label class="form-label">Current Focus</label>
            <textarea class="form-input min-h-32" name="currentFocus"><%= profile.currentFocus || '' %></textarea>
          </div>

          <div>
            <label class="form-label">Mission</label>
            <input class="form-input" name="mission" value="<%= profile.mission || '' %>" placeholder="Build, learn, share">
          </div>
        </div>
      </section>

      <section class="admin-panel p-6 md:p-8">
        <h2 class="text-2xl font-bold text-white">Skills & Links</h2>
        <p class="mt-2 text-sm text-slate-400">Skills should be separated with commas.</p>

        <div class="mt-6 grid gap-5 md:grid-cols-2">
          <div class="md:col-span-2">
            <label class="form-label">Skills</label>
            <textarea class="form-input min-h-28" name="skills" placeholder="HTML, CSS, JavaScript, Node.js"><%= (profile.skills || []).join(', ') %></textarea>
          </div>

          <div>
            <label class="form-label">GitHub URL</label>
            <input class="form-input" name="github" value="<%= social.github || '' %>" placeholder="https://github.com/username">
          </div>

          <div>
            <label class="form-label">LinkedIn URL</label>
            <input class="form-input" name="linkedin" value="<%= social.linkedin || '' %>" placeholder="https://linkedin.com/in/username">
          </div>

          <div>
            <label class="form-label">Twitter/X URL</label>
            <input class="form-input" name="twitter" value="<%= social.twitter || '' %>" placeholder="https://x.com/username">
          </div>

          <div>
            <label class="form-label">Portfolio URL</label>
            <input class="form-input" name="portfolio" value="<%= social.portfolio || '' %>" placeholder="https://example.com">
          </div>

          <div>
  <label class="form-label">Resume URL</label>
  <input
    class="form-input"
    name="resume"
    value="<%= social.resume || '' %>"
    placeholder="https://example.com/resume.pdf or upload below"
  >
  <p class="mt-2 text-xs text-slate-500">
    Paste a resume link, or upload your PDF CV below.
  </p>
</div>

<div>
  <label class="form-label">Upload Resume PDF</label>
  <input
    class="form-input"
    type="file"
    name="resumeFile"
    accept="application/pdf"
  >
  <p class="mt-2 text-xs text-slate-500">
    Accepted format: PDF only. Maximum size: 8MB.
  </p>

  <% if (social.resume && social.resume !== '#') { %>
    <a
      href="<%= social.resume %>"
      target="_blank"
      rel="noopener noreferrer"
      class="mt-3 inline-flex text-sm font-semibold text-cyan-300 hover:text-cyan-200"
    >
      View Current Resume →
    </a>
  <% } %>
</div>

          <div>
            <label class="form-label">Years Learning</label>
            <input class="form-input" name="yearsLearning" value="<%= profileStats.yearsLearning || '' %>" placeholder="3+">
          </div>
        </div>
      </section>

      <section class="admin-panel p-6 md:p-8">
        <h2 class="text-2xl font-bold text-white">SEO</h2>
        <p class="mt-2 text-sm text-slate-400">Basic search engine information for the homepage.</p>

        <div class="mt-6 grid gap-5">
          <div>
            <label class="form-label">SEO Title</label>
            <input class="form-input" name="seoTitle" value="<%= profile.seoTitle || '' %>">
          </div>

          <div>
            <label class="form-label">SEO Description</label>
            <textarea class="form-input min-h-28" name="seoDescription"><%= profile.seoDescription || '' %></textarea>
          </div>
        </div>
      </section>

      <div class="flex flex-wrap justify-end gap-4">
        <a href="/admin/dashboard" class="btn-secondary">Cancel</a>
        <button type="submit" class="btn-primary">Save Settings</button>
      </div>
    </form>
  </div>
</main>

<%- include('../partials/admin-footer') %>
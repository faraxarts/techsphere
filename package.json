{
  "name": "techsphere-portfolio-blog",
  "version": "1.0.0",
  "description": "TechSphere: a personal portfolio and tech blog built with Node.js, Express, EJS, MongoDB, and Tailwind CSS.",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "build:css": "tailwindcss -i ./public/css/input.css -o ./public/css/output.css --minify",
    "watch:css": "tailwindcss -i ./public/css/input.css -o ./public/css/output.css --watch",
    "create-admin": "node scripts/createAdmin.js",
    "reset-admin": "node scripts/resetAdminPassword.js"
  },
  "keywords": [
    "portfolio",
    "blog",
    "express",
    "ejs",
    "mongodb",
    "tailwind"
  ],
  "author": "Faramade Ayeni",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "connect-flash": "^0.1.1",
    "connect-mongo": "^4.6.0",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "mongoose": "^9.0.2",
    "multer": "^2.1.1",
    "nodemailer": "^7.0.10"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "nodemon": "^3.1.10",
    "postcss": "^8.4.49",
    "tailwindcss": "3.4.17"
  }
}
